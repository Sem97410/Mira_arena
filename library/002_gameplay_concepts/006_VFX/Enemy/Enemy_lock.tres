code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color;
uniform vec2 Trail_Speed;
uniform sampler2D tex_frg_2;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_14;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = ColorParameter;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = Trail_Speed;


// VectorOp:6
	vec2 n_out6p0 = vec2(n_out5p0) * n_out7p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out6p0 * n_in4p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


// Input:10
	vec2 n_out10p0 = UV;


// VectorOp:9
	vec2 n_in9p1 = vec2(0.25000, 0.00000);
	vec2 n_out9p0 = n_out10p0 * n_in9p1;


// Vector2Parameter:11
	vec2 n_out11p0 = Vector2Parameter;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out11p0 * n_in8p1 + n_out9p0;


// Texture2D:14
	vec4 n_out14p0 = texture(tex_frg_14, n_out8p0);


// FloatOp:12
	float n_out12p0 = n_out2p0.x - n_out14p0.x;


// Clamp:13
	float n_in13p1 = 0.00000;
	float n_in13p2 = 1.00000;
	float n_out13p0 = clamp(n_out12p0, n_in13p1, n_in13p2);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out13p0;


}
