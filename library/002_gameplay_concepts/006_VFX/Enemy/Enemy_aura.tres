code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_3;
uniform vec2 Vector2Parameter2;
uniform sampler2D tex_frg_10;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// Input:6
	float n_out6p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = Vector2Parameter;


// VectorOp:5
	vec2 n_out5p0 = vec2(n_out6p0) * n_out7p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out5p0 * n_in4p1 + UV;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out4p0);


// Input:13
	vec2 n_out13p0 = UV;


// Vector2Parameter:14
	vec2 n_out14p0 = Vector2Parameter2;


// VectorOp:12
	vec2 n_out12p0 = n_out13p0 * n_out14p0;


// UVFunc:11
	vec2 n_in11p1 = vec2(1.00000, 1.00000);
	vec2 n_out11p0 = n_out12p0 * n_in11p1 + UV;


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, n_out11p0);


// FloatOp:8
	float n_out8p0 = n_out3p0.x - n_out10p0.x;


// Clamp:9
	float n_in9p1 = 0.00000;
	float n_in9p2 = 1.00000;
	float n_out9p0 = clamp(n_out8p0, n_in9p1, n_in9p2);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out9p0;


}
