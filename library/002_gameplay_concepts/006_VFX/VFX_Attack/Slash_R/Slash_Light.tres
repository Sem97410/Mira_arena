code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 ColorParameter : source_color;
uniform float slider;
uniform sampler2D tex_frg_20;
uniform float slider2;
uniform sampler2D tex_frg_19;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// Input:4
	vec2 n_out4p0 = UV;


// VectorOp:17
	vec2 n_in17p1 = vec2(0.00000, 0.60000);
	vec2 n_out17p0 = n_out4p0 * n_in17p1;


// FloatParameter:5
	float n_out5p0 = slider;


// UVFunc:3
	vec2 n_in3p1 = vec2(0.00000, 1.00000);
	vec2 n_out3p0 = vec2(n_out5p0) * n_in3p1 + n_out17p0;


// Texture2D:20
	vec4 n_out20p0 = texture(tex_frg_20, n_out3p0);


// Input:14
	vec2 n_out14p0 = UV;


// VectorOp:18
	vec2 n_in18p1 = vec2(1.00000, 1.00000);
	vec2 n_out18p0 = n_out14p0 * n_in18p1;


// FloatParameter:15
	float n_out15p0 = slider2;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 0.00000);
	vec2 n_out13p0 = vec2(n_out15p0) * n_in13p1 + n_out18p0;


// Texture2D:19
	vec4 n_out19p0 = texture(tex_frg_19, n_out13p0);


// VectorOp:6
	vec4 n_out6p0 = n_out20p0 * n_out19p0;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out6p0.x;


}
"
