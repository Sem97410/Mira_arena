// UVFunc:17
	vec2 n_in17p1 = vec2(0.00000, 1.00000);
	vec2 n_out17p0 = vec2(n_out19p0) * n_in17p1 + n_out18p0;


// Texture2D:22
	vec4 n_out22p0 = texture(tex_frg_22, n_out17p0);


// FloatOp:21
	float n_out21p0 = n_out13p0.x * n_out22p0.x;


// VectorOp:6
	vec4 n_out6p0 = n_out15p0 * vec4(n_out21p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out6p0.x;


}
