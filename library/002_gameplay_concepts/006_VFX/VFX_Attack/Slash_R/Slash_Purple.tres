// Input:16
	vec2 n_out16p0 = UV;


// VectorOp:18
	vec2 n_in18p1 = vec2(0.25000, 0.30000);
	vec2 n_out18p0 = n_out16p0 * n_in18p1;


// FloatParameter:19
