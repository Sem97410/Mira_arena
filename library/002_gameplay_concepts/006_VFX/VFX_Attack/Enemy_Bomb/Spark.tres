render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 ColorParameter : source_color;
uniform sampler2D curve_frg_6 : repeat_disable;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_11;



void fragment() {
// ColorParameter:8
	vec4 n_out8p0 = ColorParameter;


// Input:4
	vec2 n_out4p0 = UV;


// Input:5
	vec4 n_out5p0 = COLOR;
	float n_out5p1 = n_out5p0.r;
	float n_out5p4 = n_out5p0.a;


// CurveTexture:6
	float n_out6p0 = texture(curve_frg_6, vec2(n_out5p1)).r;


// VectorCompose:7
	float n_in7p1 = 0.00000;
	vec2 n_out7p0 = vec2(n_out6p0, n_in7p1);


// MultiplyAdd:3
	vec2 n_in3p1 = vec2(0.25000, 1.00000);
	vec2 n_out3p0 = fma(n_out4p0, n_in3p1, n_out7p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);
	float n_out2p1 = n_out2p0.r;


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);
	float n_out11p1 = n_out11p0.r;


// SmoothStep:10
	float n_in10p1 = 1.00000;
	float n_out10p0 = smoothstep(n_out5p4, n_in10p1, n_out11p1);


// FloatOp:12
	float n_out12p0 = n_out2p1 * n_out10p0;


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);
	ALPHA = n_out12p0;


}
