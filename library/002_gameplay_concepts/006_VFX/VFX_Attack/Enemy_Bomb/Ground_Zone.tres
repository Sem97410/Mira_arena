code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 ColorParameter : source_color;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_2;
uniform vec2 Opacity;
uniform sampler2D tex_frg_9;



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = ColorParameter;


// Input:5
	float n_out5p0 = TIME;


// Vector2Parameter:6
	vec2 n_out6p0 = Vector2Parameter;


// VectorOp:4
	vec2 n_out4p0 = vec2(n_out5p0) * n_out6p0;


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out4p0 * n_in3p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);
	float n_out2p1 = n_out2p0.r;


// Input:13
	vec2 n_out13p0 = UV;


// VectorOp:14
	vec3 n_in14p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out14p0 = vec3(n_out13p0, 0.0) + n_in14p1;


// Vector2Parameter:12
	vec2 n_out12p0 = Opacity;


// VectorOp:11
	vec2 n_out11p0 = vec2(n_out14p0.xy) * n_out12p0;


// UVFunc:10
	vec2 n_in10p1 = vec2(0.00000, 1.00000);
	vec2 n_out10p0 = n_out11p0 * n_in10p1 + UV;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, n_out10p0);


// FloatOp:8
	float n_out8p0 = n_out2p1 * n_out9p0.x;


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out8p0;


}
"
