code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color;
uniform float Alpha;
uniform float Light;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = ColorParameter;


// FloatParameter:3
	float n_out3p0 = Alpha;


// Output:0
	COLOR.rgb = vec3(n_out2p0.xyz);
	COLOR.a = n_out3p0;


}

void light() {
// FloatParameter:2
	float n_out2p0 = Light;


// Output:0
	LIGHT.rgb = vec3(n_out2p0);


}
