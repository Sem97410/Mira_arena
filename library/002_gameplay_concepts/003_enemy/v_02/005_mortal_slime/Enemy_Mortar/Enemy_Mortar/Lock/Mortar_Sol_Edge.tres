render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_9;
uniform sampler2D tex_frg_2;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = ColorParameter;


// Vector2Parameter:6
	vec2 n_out6p0 = Vector2Parameter;


// Input:5
	float n_out5p0 = TIME;


// VectorOp:7
	vec2 n_out7p0 = n_out6p0 * vec2(n_out5p0);


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out7p0 * n_in4p1 + UV;


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, n_out4p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// FloatOp:8
	float n_out8p0 = n_out9p0.x * n_out2p0.x;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out8p0;


}
