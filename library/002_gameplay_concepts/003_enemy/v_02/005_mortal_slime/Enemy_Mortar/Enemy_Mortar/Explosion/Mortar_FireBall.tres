[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Cloud_Speed;
uniform sampler2D tex_vtx_5;
uniform float Cload_Intensity;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3 : source_color;
uniform sampler2D tex_frg_11;
uniform sampler2D depth_tex_frg_20 : hint_depth_texture;
uniform vec4 Explosion_Color : source_color = vec4(0.926296, 0.348026, 0.000000, 1.000000);
uniform sampler2D tex_frg_7 : source_color;
uniform sampler2D tex_lgt_2;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:3
	vec3 n_out3p0 = NORMAL;


// Input:9
	float n_out9p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = Cloud_Speed;


// VectorOp:10
	vec2 n_out10p0 = vec2(n_out9p0) * n_out12p0;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out10p0 * n_in8p1 + UV;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_vtx_5, n_out8p0);


// FloatParameter:11
	float n_out11p0 = Cload_Intensity;


// FloatOp:7
	float n_out7p0 = n_out5p0.x * n_out11p0;


// VectorOp:6
	vec3 n_out6p0 = n_out3p0 * vec3(n_out7p0);


// VectorOp:4
	vec3 n_out4p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out4p0;


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p1 = n_out2p0.r;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out2p1));


// Input:17
	vec4 n_out17p0 = COLOR;
	float n_out17p4 = n_out17p0.a;


// Texture2D:11
	vec4 n_out11p0 = texture(tex_frg_11, UV);
	float n_out11p1 = n_out11p0.r;


// SmoothStep:12
	float n_in12p1 = 1.00000;
	float n_out12p0 = smoothstep(n_out17p4, n_in12p1, n_out11p1);


	float n_out20p0;
// ProximityFade:20
	float n_in20p0 = 1.00000;
	{
		float __depth_tex = texture(depth_tex_frg_20, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out20p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_in20p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:19
	float n_out19p0 = n_out12p0 * n_out20p0;


// ColorParameter:4
	vec4 n_out4p0 = Explosion_Color;


// FloatConstant:6
	float n_out6p0 = 20.000000;


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0.xyz) * vec3(n_out6p0);


// Input:18
	vec4 n_out18p0 = COLOR;
	float n_out18p1 = n_out18p0.r;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);
	float n_out7p1 = n_out7p0.r;


// SmoothStep:10
	float n_in10p1 = 1.00000;
	float n_out10p0 = smoothstep(n_out18p1, n_in10p1, n_out7p1);


// VectorOp:8
	vec3 n_out8p0 = n_out5p0 * vec3(n_out10p0);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out19p0;
	EMISSION = n_out8p0;


}

void light() {
// Input:5
	vec3 n_out5p0 = LIGHT;


// Input:6
	vec3 n_out6p0 = NORMAL;


// DotProduct:4
	float n_out4p0 = dot(n_out5p0, n_out6p0);


	float n_out7p0;
// Remap:7
	float n_in7p1 = 0.00000;
	float n_in7p2 = 1.00000;
	float n_in7p3 = 0.00000;
	float n_in7p4 = 1.00000;
	{
		float __input_range = n_in7p2 - n_in7p1;
		float __output_range = n_in7p4 - n_in7p3;
		n_out7p0 = n_in7p3 + __output_range * ((n_out4p0 - n_in7p1) / __input_range);
	}


// Texture2D:2
	vec4 n_out2p0 = texture(tex_lgt_2, vec2(n_out7p0));


// Output:0
	DIFFUSE_LIGHT = vec3(n_out2p0.xyz);


}
"
