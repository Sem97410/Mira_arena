code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, shadows_disabled, ambient_light_disabled;

uniform vec4 ColorParameter : source_color;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_2;
uniform vec2 Vector2Parameter2;
uniform sampler2D tex_frg_5;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = ColorParameter;


// Vector2Parameter:7
	vec2 n_out7p0 = Vector2Parameter;


// Input:6
	float n_out6p0 = TIME;


// VectorOp:8
	vec2 n_out8p0 = n_out7p0 * vec2(n_out6p0);


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out8p0 * n_in9p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out9p0);
	float n_out2p1 = n_out2p0.r;


// Input:16
	vec4 n_out16p0 = COLOR;
	float n_out16p4 = n_out16p0.a;


// Vector2Parameter:11
	vec2 n_out11p0 = Vector2Parameter2;


// Input:10
	vec2 n_out10p0 = UV;


// VectorOp:12
	vec2 n_out12p0 = n_out11p0 * n_out10p0;


// UVFunc:13
	vec2 n_in13p1 = vec2(1.00000, 1.00000);
	vec2 n_out13p0 = n_out12p0 * n_in13p1 + UV;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, n_out13p0);
	float n_out5p1 = n_out5p0.r;


// SmoothStep:15
	float n_in15p1 = 1.00000;
	float n_out15p0 = smoothstep(n_out16p4, n_in15p1, n_out5p1);


// FloatOp:4
	float n_out4p0 = n_out2p1 * n_out15p0;


// Clamp:14
	float n_in14p1 = 0.00000;
	float n_in14p2 = 1.00000;
	float n_out14p0 = clamp(n_out4p0, n_in14p1, n_in14p2);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out14p0;


}
