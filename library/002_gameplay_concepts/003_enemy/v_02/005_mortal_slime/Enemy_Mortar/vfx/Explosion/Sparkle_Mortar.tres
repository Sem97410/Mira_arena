code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 Streaks_Color : source_color;
uniform sampler2D curve_frg_15 : repeat_disable;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_18 : source_color;



void fragment() {
// ColorParameter:17
	vec4 n_out17p0 = Streaks_Color;


// Input:3
	vec2 n_out3p0 = UV;


// Input:14
	vec4 n_out14p0 = COLOR;
	float n_out14p1 = n_out14p0.r;
	float n_out14p4 = n_out14p0.a;


// CurveTexture:15
	float n_out15p0 = texture(curve_frg_15, vec2(n_out14p1)).r;


// VectorCompose:16
	float n_in16p1 = 0.00000;
	vec2 n_out16p0 = vec2(n_out15p0, n_in16p1);


// MultiplyAdd:4
	vec2 n_in4p1 = vec2(0.25000, 1.00000);
	vec2 n_out4p0 = fma(n_out3p0, n_in4p1, n_out16p0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out4p0);


// Texture2D:18
	vec4 n_out18p0 = texture(tex_frg_18, UV);
	float n_out18p1 = n_out18p0.r;


// SmoothStep:19
	float n_in19p1 = 1.00000;
	float n_out19p0 = smoothstep(n_out14p4, n_in19p1, n_out18p1);


// FloatOp:12
	float n_out12p0 = n_out2p0.x * n_out19p0;


// Output:0
	ALBEDO = vec3(n_out17p0.xyz);
	ALPHA = n_out12p0;


}
"
