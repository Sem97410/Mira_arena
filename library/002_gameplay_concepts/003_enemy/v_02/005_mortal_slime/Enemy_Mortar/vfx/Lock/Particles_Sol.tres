render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_vtx_6;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_10;
uniform sampler2D tex_frg_2 : source_color;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:11
	float n_out11p0 = TIME;


// Vector2Constant:12
	vec2 n_out12p0 = vec2(0.100000, 1.000000);


// VectorOp:10
	vec3 n_out10p0 = vec3(n_out11p0) * vec3(n_out12p0, 0.0);


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = vec2(n_out10p0.xy) * n_in9p1 + UV;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_vtx_6, n_out9p0);


// Input:5
	vec3 n_out5p0 = NORMAL;


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out6p0.xyz) * n_out5p0;


// FloatConstant:8
	float n_out8p0 = 0.050000;


// VectorOp:4
	vec3 n_out4p0 = n_out7p0 * vec3(n_out8p0);


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + n_out4p0;


// Output:0
	VERTEX = n_out3p0;


}

void fragment() {
// Input:5
	vec4 n_out5p0 = COLOR;
	float n_out5p4 = n_out5p0.a;


// Vector2Parameter:8
	vec2 n_out8p0 = Vector2Parameter;


// Input:7
	float n_out7p0 = TIME;


// VectorOp:9
	vec2 n_out9p0 = n_out8p0 * vec2(n_out7p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out9p0 * n_in6p1 + UV;


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, n_out6p0);
	float n_out10p1 = n_out10p0.r;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);
	float n_out2p1 = n_out2p0.r;


// FloatOp:3
	float n_out3p0 = n_out10p1 * n_out2p1;


// FloatOp:4
	float n_out4p0 = n_out5p4 * n_out3p0;


// Output:0
	ALBEDO = vec3(n_out5p0.xyz);
	ALPHA = n_out4p0;


}
