render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded, ambient_light_disabled;

uniform vec4 ColorParameter : source_color;
uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_4;
uniform sampler2D tex_frg_2 : source_color;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = ColorParameter;


// Vector2Parameter:8
	vec2 n_out8p0 = Vector2Parameter;


// Input:7
	float n_out7p0 = TIME;


// VectorOp:10
	vec2 n_out10p0 = n_out8p0 * vec2(n_out7p0);


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out10p0 * n_in6p1 + UV;


// Texture2D:4
