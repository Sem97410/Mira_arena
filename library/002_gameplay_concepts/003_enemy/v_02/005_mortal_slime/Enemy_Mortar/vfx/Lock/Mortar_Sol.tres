// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// FloatOp:5
	float n_out5p0 = n_out4p0.x * n_out2p0.x;


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	ALPHA = n_out5p0;


}
