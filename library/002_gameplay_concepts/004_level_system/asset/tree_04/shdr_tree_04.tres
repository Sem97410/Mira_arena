code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_3;
uniform sampler2D tex_frg_4;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// VectorDecompose:3
	float n_out3p0 = n_out2p0.x;
	float n_out3p1 = n_out2p0.y;
	float n_out3p2 = n_out2p0.z;


// TransformVectorMult:5
	mat4 n_in5p0 = mat4(vec4(1.00000, 0.00000, 0.00000, 0.0), vec4(0.00000, 1.00000, 0.00000, 0.0), vec4(0.00000, 0.00000, 1.00000, 0.0), vec4(0.00000, 0.00000, 0.00000, 1.0));
	vec3 n_out5p0 = (vec4(vec3(n_out3p1), 1.0) * n_in5p0).xyz;


// SmoothStep:4
	float n_in4p1 = 1.00000;
	float n_in4p2 = 1.62000;
	float n_out4p0 = smoothstep(n_out5p0.x, n_in4p1, n_in4p2);


// Output:0
	NORMAL = vec3(n_out4p0);


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out3p0.x;
	NORMAL_MAP = vec3(n_out4p0.xyz);


}
